# Copie para .env.local OU use npm run instance:init. Não cadastre senhas aqui.
# Variáveis VITE_ são públicas e entram no build; nunca coloque conta de serviço,
# chave privada ou token de administrador nestas variáveis.
VITE_INSTANCE_ID=demo
VITE_ESTABLISHMENT_NAME="Navalha & Co."
VITE_INSTANCE_DOMAIN=

# Apenas preparação de configuração: não existe conexão Firebase na v0.1.
# Obtenha a configuração Web pública do projeto do cliente ao integrar o SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
