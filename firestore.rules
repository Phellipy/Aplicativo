rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/administrators/$(request.auth.uid))
        && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.email == request.auth.token.email;
    }
    function allowedKey(key) {
      return key in ['establishment-name','presence','appearance','logo','return-days','appointments','clients','procedures','campaigns','work-schedules','professional-records','message','appointment-message','appointment-reminders'];
    }
    function validItem() {
      return request.resource.data.keys().hasOnly(['value','position','revision'])
        && request.resource.data.keys().hasAll(['value','position','revision'])
        && request.resource.data.position is int && request.resource.data.position >= 0
        && request.resource.data.revision is int;
    }
    match /administrators/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /instances/demo/data/{key}/items/{id} {
      allow read: if isAdmin() && allowedKey(key);
      allow create: if isAdmin() && allowedKey(key) && validItem() && request.resource.data.revision == 1;
      allow update: if isAdmin() && allowedKey(key) && validItem() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if isAdmin() && allowedKey(key);
    }
    match /publicBranding/demo {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','logo','appearance'])
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
        && (!('logo' in request.resource.data) || (request.resource.data.logo is string && request.resource.data.logo.size() <= 700000 && (request.resource.data.logo == '' || request.resource.data.logo.matches('data:image/(png|jpeg|webp);base64,.*'))))
        && (!('appearance' in request.resource.data) || (request.resource.data.appearance is map && request.resource.data.appearance.keys().hasOnly(['mode','accent']) && request.resource.data.appearance.mode in ['light','dark'] && request.resource.data.appearance.accent in ['blue','pink','purple','black','white','gray','brown','orange','red','green','yellow','dark-turquoise']));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
